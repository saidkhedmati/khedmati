rules_version = '2';

// نسخ هاد الكود لـ Firebase Console > Firestore Database > Rules
// كيسمح للمستخدم المسجل الدخول غير يبدل البيانات ديالو هو
service cloud.firestore {
  match /databases/{database}/documents {

    // كل مستخدم يقدر يقرا بروفايلات الآخرين، ولكن يبدل غير ديالو
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // كل واحد مسجل الدخول يقدر يقرا الطلبات، وينشر طلب جديد،
    // ولكن يبدل أو يحيد غير الطلبات ديالو هو
    match /requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // المحادثات - يقدر يقرا/يكتب فيها غير الجوج ديال الناس المعنيين
    match /chats/{chatId} {
      allow read, update: if request.auth != null
                    && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participantIds;

      match /messages/{messageId} {
        allow read, create: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
  }
}
